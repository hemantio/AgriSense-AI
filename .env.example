# ============================================================
# AgriSense AI — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control!
# ============================================================

# --- Application ---
APP_NAME=AgriSense AI
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1

# --- Server ---
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=["http://localhost:3000"]

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://agrisense:agrisense_secret@localhost:5432/agrisense_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=false

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- JWT Authentication ---
# IMPORTANT: Generate a secure random key for production!
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE-THIS-TO-A-SECURE-RANDOM-KEY-IN-PRODUCTION
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# --- Rate Limiting ---
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=20/minute
RATE_LIMIT_UPLOAD=30/minute

# --- File Upload ---
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# --- External APIs ---
# OpenWeatherMap: Get free key at https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Google Gemini: Get free key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=console

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=AgriSense AI
NEXTAUTH_SECRET=CHANGE-THIS-TO-A-SECURE-RANDOM-KEY
NEXTAUTH_URL=http://localhost:3000
